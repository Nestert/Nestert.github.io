{% set ogImage = site.url ~ site.preview.image %}
{% set twitterImage = site.url ~ site.preview.wideImage %}
{% set ogImageAlt = site.preview.alt %}
{% if image %}
  {% set ogImage = site.url ~ image %}
  {% set twitterImage = ogImage %}
  {% set ogImageAlt = title or site.title %}
{% endif %}
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:locale" content="ru_RU">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:type" content="{% if page.url == '/' %}website{% else %}article{% endif %}">
<meta property="og:url" content="{{ canonicalUrl }}">
<meta property="og:image" content="{{ ogImage }}">
<meta property="og:image:alt" content="{{ ogImageAlt }}">
{% if not image %}
  <meta property="og:image:type" content="{{ site.preview.type }}">
  <meta property="og:image:width" content="{{ site.preview.width }}">
  <meta property="og:image:height" content="{{ site.preview.height }}">
  {# A second Open Graph image offers a landscape option; keep the square first
     for previews that would otherwise crop the long handwritten logo. #}
  <meta property="og:image" content="{{ site.url }}{{ site.preview.wideImage }}">
  <meta property="og:image:type" content="{{ site.preview.type }}">
  <meta property="og:image:width" content="{{ site.preview.width }}">
  <meta property="og:image:height" content="{{ site.preview.wideHeight }}">
  <meta property="og:image:alt" content="{{ ogImageAlt }}">
{% endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ twitterImage }}">
<meta name="twitter:image:alt" content="{{ ogImageAlt }}">
